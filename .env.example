SNOWLUMA_WS_URL=ws://snowluma.orb.local:3001/
SNOWLUMA_ACCESS_TOKEN=your_token_here

# Test group isolation (Optional)
# DEV_MODE=false
# DEV_GROUP_ID=your_test_group_id_here

# Firecrawl API Key (Optional, enables higher rate limits for link preview fallback scraping)
# FIRECRAWL_API_KEY=fc-your_api_key_here

# OpenRouter API Key (Optional, shared by link preview decision filter and /gen image generation)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OpenRouter Decision Model (Optional, required together with OPENROUTER_API_KEY to enable link preview decision filter)
# OPENROUTER_DECISION_MODEL=your_decision_model_here
# OpenRouter Image Model (Optional, required together with OPENROUTER_API_KEY to enable /gen image generation, e.g. recraft/recraft-v4.1-flash-v2:free)
# OPENROUTER_IMAGE_MODEL=recraft/recraft-v4.1-flash-v2:free
# SauceNao API Key (Optional, increases search limit)
# SAUCENAO_API_KEY=your_saucenao_api_key_here

# Danbooru API Credentials (Optional, both required to raise /dbr tag search limit from 2 to 3)
# DANBOORU_LOGIN=your_danbooru_username
# DANBOORU_API_KEY=your_danbooru_api_key
